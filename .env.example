# Optional persistent account server, Node 24+. Existing static demo is unaffected.
PORT=4324
ACCOUNT_ORIGIN=http://127.0.0.1:4324
# ACCOUNT_DATABASE_PATH=C:/path/outside/public/accounts.sqlite
# Keep all credentials on the server. Never place this file in public/ or commit .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Enable only channels configured in Verify. Email also needs its SendGrid integration.
VERIFICATION_CHANNELS=
# A random secret of at least 32 characters shared ONLY with the trusted game adapter.
# This does not connect an actual game provider by itself.
GAME_EVENT_SECRET=
