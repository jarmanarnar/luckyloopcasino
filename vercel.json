{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/luckyloopcasino/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/luckyloop-casino/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/atomic-design/:path*", "destination": "/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
